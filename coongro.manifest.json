{
  "id": "ai-copilot",
  "version": "0.1.0",
  "apiVersion": "2.0",
  "displayName": "Asistente IA",
  "description": "Copiloto agéntico: ve la interfaz de Coongro como texto (árbol ARIA) y decide la próxima acción (navegar, click, escribir, seleccionar) para cumplir el objetivo del usuario en cualquier módulo instalado. Usa el gateway openrouter como motor LLM y consume Unidades de trabajo por tarea.",
  "runtime": "eager",
  "entry": "./dist/entry.js",
  "contributes": {
    "menus": [
      {
        "path": "Agentes IA",
        "viewId": "ai-copilot.conexiones-de-agentes.open",
        "icon": "Bot",
        "order": 90
      }
    ],
    "views": [
      {
        "id": "ai-copilot.nueva-conexion.open",
        "title": "Nueva conexión",
        "component": "./dist/views/nueva-conexion/index.js",
        "export": "NuevaConexionView"
      },
      {
        "id": "ai-copilot.conexiones-de-agentes.open",
        "title": "Conexiones de agentes",
        "component": "./dist/views/conexiones-de-agentes/index.js",
        "export": "ConexionesDeAgentesView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/agent-connection.repository.js",
        "export": "ConnectionRepository",
        "prefix": "ai-copilot.connections",
        "copilot": false
      }
    ],
    "utilityActions": [
      {
        "id": "ai-copilot.chat",
        "icon": "assets/icons/sparkles.svg",
        "label": "Asistente IA",
        "order": 40,
        "panelType": "drawer",
        "component": "./dist/panel/index.js",
        "export": "CopilotDrawer"
      }
    ],
    "httpEndpoints": [
      {
        "id": "turn",
        "path": "/turn",
        "method": "POST",
        "handler": "./dist/endpoints/turn.js",
        "export": "turn",
        "auth": "jwt"
      },
      {
        "id": "mcp",
        "path": "/mcp",
        "method": "POST",
        "handler": "./dist/endpoints/mcp.js",
        "export": "mcp",
        "auth": "none"
      },
      {
        "id": "connections-context",
        "path": "/connections/context",
        "method": "GET",
        "handler": "./dist/endpoints/connections.js",
        "export": "context",
        "auth": "jwt"
      },
      {
        "id": "config-prompt-get",
        "path": "/config/prompt",
        "method": "GET",
        "handler": "./dist/endpoints/config-prompt.js",
        "export": "getPrompt",
        "auth": "none"
      },
      {
        "id": "config-prompt-set",
        "path": "/config/prompt",
        "method": "PUT",
        "handler": "./dist/endpoints/config-prompt.js",
        "export": "setPrompt",
        "auth": "none"
      }
    ],
    "copilotCapabilities": []
  }
}
